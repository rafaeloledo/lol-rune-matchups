{
  "name": "lol-rune-matchups-frontend",
  "version": "0.1.0",
  "private": true,
  "description": "TypeScript + Tailwind build for the LoL Rune Matchups frontend",
  "scripts": {
    "build": "npm run build:css && npm run build:ts",
    "build:ts": "tsc -p frontend",
    "build:css": "tailwindcss -c tailwind.config.js -i frontend/styles.css -o static/styles.css --minify",
    "watch": "npm-run-all -p watch:ts watch:css",
    "watch:ts": "tsc -p frontend --watch --preserveWatchOutput",
    "watch:css": "tailwindcss -c tailwind.config.js -i frontend/styles.css -o static/styles.css --watch"
  },
  "devDependencies": {
    "npm-run-all": "^4.1.5",
    "tailwindcss": "^3.4.19",
    "typescript": "^5.6.0"
  }
}
